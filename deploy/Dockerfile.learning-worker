FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN npm install --global pnpm@10.33.2 && pnpm install --frozen-lockfile --prod --ignore-scripts
FROM node:22-bookworm-slim
ENV NODE_ENV=production WORKER_PORT=8080
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node src/lib/learning ./src/lib/learning
COPY --chown=node:node src/lib/mcp ./src/lib/mcp
COPY --chown=node:node scripts/learning-worker.mjs scripts/learning-service.mjs ./scripts/
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","scripts/learning-worker.mjs"]
