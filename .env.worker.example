# Server worker only. Never put these secrets in NEXT_PUBLIC variables or the web deployment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Complete HTTPS Chat Completions endpoint of a server API provider you have approved.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
# Use max_tokens only for a provider explicitly requiring the legacy field.
AI_TOKEN_PARAMETER=max_completion_tokens
PORT=8080
