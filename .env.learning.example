# Existing Next.js app configuration (no service key needed in Next.js):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=https://YOUR_APP_HOST

# Worker/seed only. Copy these into .env.worker, which must not be committed.
SUPABASE_SECRET_KEY=
# Complete HTTPS Chat Completions endpoint, selected by the operator.
LEARNING_MODEL_ENDPOINT=
LEARNING_MODEL=
LEARNING_MODEL_API_KEY=
WORKER_PORT=8080
# Local-development endpoints are opt-in and must not be enabled in production.
LEARNING_ALLOW_LOCAL_DB=false
LEARNING_ALLOW_LOCAL_MODEL=false
