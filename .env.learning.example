# Web only. Never expose an AI Gateway / Supabase secret key through NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=https://YOUR_APP_HOST

# Worker/seed only: copy to untracked .env.worker and configure on its server.
SUPABASE_SECRET_KEY=
LEARNING_MODEL_PROVIDER=vercel
AI_GATEWAY_API_KEY=
# A metered model, NOT an unlimited free endpoint. Available credits are used.
LEARNING_MODEL=openai/gpt-oss-120b
LEARNING_MODEL_MAX_OUTPUT_TOKENS=2048
# Safe default. Vercel currently requires Pro/Enterprise for per-request ZDR.
LEARNING_GATEWAY_PRIVACY=zdr
# On free/Hobby, synthetic-data testing ONLY can explicitly set:
# LEARNING_GATEWAY_PRIVACY=synthetic
# Both modes disallow provider prompt training. Synthetic mode does NOT require ZDR.
# Optional comma-separated provider allowlist; empty means Gateway may route
# the same model among providers that satisfy the requested privacy policy.
LEARNING_GATEWAY_PROVIDERS=
WORKER_PORT=8080
LEARNING_ALLOW_LOCAL_DB=false
LEARNING_ALLOW_LOCAL_MODEL=false

# CI uses LEARNING_MODEL_PROVIDER=compatible with a loopback fixture. Do not
# carry LEARNING_MODEL_ENDPOINT or LEARNING_MODEL_API_KEY into Gateway mode.
# A Vercel app connection/token is not a standalone worker Gateway API key.
