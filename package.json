{
  "name": "science-sos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/api-http.test.mjs scripts/unit/*.test.mjs",
    "test:classroom": "node --env-file=.env.local scripts/classroom-integration.mjs",
    "worker": "node --experimental-strip-types --env-file=.env.worker scripts/learning-worker.mjs",
    "test:demo": "vitest run scripts/demo-store.test.ts",
    "test:integration": "node --env-file=.env.local scripts/integration.mjs",
    "test:unit": "node --experimental-strip-types --test scripts/unit/*.test.mjs",
    "typecheck:foundation": "tsc -p tsconfig.foundation.json",
    "worker:legacy": "node --env-file=.env.local scripts/cursor-worker.mjs",
    "test:browser": "python scripts/browser/learning.py"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
